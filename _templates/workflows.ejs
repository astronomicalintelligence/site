```{=html}
<ul class="wf-list list">
<% const TYPES = ["workflows","prompts","skills","agent-configs","model-checks","reviews","failures"]; const NAMES = {"workflows": "Workflow", "prompts": "Prompt", "skills": "Skill", "agent-configs": "Agent <br>config", "model-checks": "Model <br>check", "reviews": "Review", "failures": "Failure"}; %><% for (const item of items) { const ty = TYPES.find(t => item.path.includes(t + "/")) || "workflows"; %><li class="type-<%= ty %>" <%= metadataAttrs(item) %>><span class="wf-cat"><span class="listing-catalog"><%= item.catalog || "new" %></span><span class="wf-type"><%- NAMES[ty] %></span></span><a class="wf-title listing-title" href="<%- item.path %>"><%= item.title %></a><% if (item.description) { %><p class="wf-desc listing-description"><%= item.description %></p><% } %><div class="wf-meta"><% if (item.qflag) { %><span class="qflag qflag-<%= item.qflag %> listing-qflag" title="Verification level"><%= item.qflag %></span><% } %><% if (item.author) { %><span class="wf-author">by <span class="listing-author"><%= Array.isArray(item.author) ? item.author.join(", ") : item.author %></span></span><% } %><% if (item.phase) { %><span class="listing-phase"><%= item.phase %></span><% } %><% if (item.model) { %><span>model: <span class="listing-model"><%= item.model %></span></span><% } %><% if (item.tested) { %><span>tested: <span class="listing-tested"><%= item.tested %></span></span><% } %></div></li>
<% } %></ul>
```
