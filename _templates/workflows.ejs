```{=html}
<ul class="wf-list">
<% for (const item of items) { %><li <%= metadataAttrs(item) %>><a class="wf-title" href="<%- item.path %>"><%= item.title %></a><% if (item.description) { %><p class="wf-desc"><%= item.description %></p><% } %><div class="wf-meta"><% if (item.qflag) { %><span class="qflag qflag-<%= item.qflag %>" title="Verification level"><%= item.qflag %></span><% } %><% if (item.phase) { %><span><%= item.phase %></span><% } %><% if (item.model) { %><span>model: <%= item.model %></span><% } %><% if (item.tested) { %><span>tested: <%= item.tested %></span><% } %></div></li>
<% } %></ul>
```
